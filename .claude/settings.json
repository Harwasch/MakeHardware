{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ngspice:*)",
      "Bash(kicad-cli:*)",
      "Bash(gmsh:*)",
      "Bash(ccx:*)",
      "Bash(konnect:*)",
      "Bash(hw-doctor:*)",
      "Bash(hw-display-start:*)",
      "Bash(/opt/hw-py/bin/python:*)",
      "Bash(/opt/hw-py/bin/strictdoc:*)",
      "Bash(scripts/hw-doctor.sh:*)",
      "Bash(scripts/req_trace.py:*)",
      "Bash(scripts/vision_board.py:*)"
    ]
  }
}
