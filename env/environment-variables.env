# MakeHardware — cloud environment "Environment variables"
# One KEY=VALUE per line in the environment dialog.

# --- Display (live KiCad only; Xvfb is started per-session by the hook) ---
DISPLAY=:99
QT_QPA_PLATFORM=xcb
LIBGL_ALWAYS_SOFTWARE=1

# --- Toolchain locations ---
HARDWARE_PYTHON=/opt/hw-py/bin/python
# ki-stack's skills locate their own bin/ and references/ through this. Unset,
# they fall back to a relative `skills/ki-stack` that resolves against the
# project directory and finds nothing.
KI_STACK_DIR=/opt/ki-stack/skills/ki-stack
# ki-stack's helpers shell out to `python3` unless told otherwise, and the
# KiCad bindings live in the toolchain venv, not in the system interpreter.
PYTHON_BIN=/opt/hw-py/bin/python
LTSPICE_MCP_CONFIG=/etc/ltspice-mcp.toml

# --- Build switches read by env/setup.sh ---
# KiCad 10 + the ki-stack skill pack. Requires ppa.launchpadcontent.net in
# the allowlist. MH_ENABLE_KONNECT was this variable's name before 0.7.0 and is
# still honoured, so an older environment keeps working unchanged.
MH_ENABLE_KICAD=1
# LTspice under Wine. Requires *.analog.com in the allowlist and adds ~2 GB
# and several minutes to the environment build. ngspice is the default.
MH_ENABLE_LTSPICE=0

# --- Wine, only meaningful when MH_ENABLE_LTSPICE=1 ---
WINEPREFIX=/opt/ltspice-wine
WINEARCH=win64
WINEDEBUG=-all
