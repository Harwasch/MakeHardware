# Build and simulation output — regenerate it, do not commit it.
#
# Note what is NOT here: docs/design/, docs/review/ and the renders under
# docs/design/vision/ are committed on purpose. They are what the human
# reviews from github.com, and an artefact nobody can see is not a
# deliverable — see the hw-review skill.
build/
sim/**/*.raw
sim/**/*.log
*.op.raw

# Generated documentation output
docs/_build/
output/

# Secrets. .env.example is committed; .env is not.
.env

# Python
__pycache__/
*.pyc
.venv/

# KiCad backups and locks
*-backups/
*.kicad_prl
fp-info-cache
~*.lck
*.kicad_sch-bak
*.kicad_pcb-bak

# OS
.DS_Store
